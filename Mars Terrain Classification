def show_kaggle_files(root="/kaggle/input", max_files=100):

    files = []

    for dirname, _, filenames in os.walk(root):

        for filename in filenames:

            files.append(
                os.path.join(dirname, filename)
            )

            if len(files) >= max_files:
                return files

    return files


all_files = show_kaggle_files()

if len(all_files) == 0:

    raise FileNotFoundError(
        "No dataset found under /kaggle/input.\n"
        "Please add a Mars image dataset to your Kaggle notebook."
