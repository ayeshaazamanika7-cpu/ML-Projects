    os.listdir(dataset_root)
):

    full_path = os.path.join(
        dataset_root,
        item
    )

    if not os.path.isdir(full_path):

        continue

    count = 0

    for _, _, files in os.walk(full_path):

        for file in files:

            if file.lower().endswith(
                IMAGE_EXTENSIONS
            ):

                count += 1

    if count >= 2:

        class_dirs.append(
            (item, full_path, count)
        )


