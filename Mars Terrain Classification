# ================================================================
# 5. DETECT FOLDER-BASED DATASET
# ================================================================

print("\n" + "=" * 70)
print("DETECTING CLASS FOLDERS")
print("=" * 70)


def find_class_directories(root):

    candidates = []

    for dirname, subdirs, filenames in os.walk(root):

        image_count = 0

        for filename in filenames:

            if filename.lower().endswith(IMAGE_EXTENSIONS):

                image_count += 1

        if image_count > 5:

            candidates.append(
                (
                    dirname,
                    image_count,
                    subdirs
                )
            )

    return candidates


class_candidates = find_class_directories(
    KAGGLE_INPUT
)


for item in class_candidates[:30]:

    print(
        "Directory:",
        item[0],
        "| Images:",
        item[1]
    )


# ================================================================
# 6. FIND PROPER DATASET ROOT
# ================================================================

dataset_root = None

# Look for a directory whose immediate children
# contain images.

for dirname, subdirs, filenames in os.walk(KAGGLE_INPUT):

    valid_subdirs = []

    for subdir in subdirs:

        full_subdir = os.path.join(
            dirname,
            subdir
        )

        count = 0

        for file in os.listdir(full_subdir):

            if file.lower().endswith(
                IMAGE_EXTENSIONS
            ):

                count += 1

        if count > 2:

            valid_subdirs.append(subdir)

    if len(valid_subdirs) >= 2:

        dataset_root = dirname

        break


