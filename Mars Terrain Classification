    ".jpeg",
    ".png",
    ".bmp",
    ".webp",
    ".tif",
    ".tiff"
)


image_files = []

for dirname, _, filenames in os.walk(KAGGLE_INPUT):

    for filename in filenames:

        if filename.lower().endswith(IMAGE_EXTENSIONS):

            image_files.append(
                os.path.join(dirname, filename)
